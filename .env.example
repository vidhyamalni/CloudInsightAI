# Copy to .env (never commit .env) or set these in your hosting dashboard.
SECRET_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
# Production database (PostgreSQL). Leave unset locally to use SQLite in instance/.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_COOKIE_SECURE=1
PRICING_LIVE=1
# FLASK_DEBUG=1   # local development only; never set in production
